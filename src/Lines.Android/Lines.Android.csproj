<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.val.lines</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <!-- net9.0-android вне поддержки: новые SDK (10/11, например в образе
         windows-latest на GitHub Actions) выдают ошибку NETSDK1202.
         Проверки отключены до перехода на net10.0-android:
         CheckEolWorkloads - проверка устаревшего workload,
         CheckEolTargetFramework - проверка устаревшего TFM -->
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogicLines\LogicLines.csproj" />
  </ItemGroup>
  <Import Project="..\Lines.Shared\Lines.Shared.projitems" Label="Shared" />
</Project>